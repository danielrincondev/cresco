{
  "name": "cresco",
  "version": "1.0.0",
  "private": true,
  "description": "Cresco — comunicacion entre docentes y representantes legales de escuelas del Ecuador",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "movil"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cresco/movil",
    "build": "npm run build --workspace @cresco/movil",
    "typecheck": "npm run typecheck --workspace @cresco/movil",
    "test": "npm test --workspace @cresco/movil",
    "env:check": "npm run env:check --workspace @cresco/movil",
    "convex:dev": "npm run convex:dev --workspace @cresco/movil",
    "convex:sync-auth-env": "npm run convex:sync-auth-env --workspace @cresco/movil"
  }
}

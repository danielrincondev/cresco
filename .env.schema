# @generateTsTypes(path=./env.d.ts)
# @defaultRequired=true
# ---
# PostgreSQL connection used by the running applications (RLS-constrained role).
# @type=url @sensitive
DATABASE_URL=

# PostgreSQL owner connection used only by Drizzle migrations.
# @type=url @sensitive @optional
DATABASE_MIGRATION_URL=

# Better Auth signing secret. Generate a random value of at least 32 characters.
# @type=string(minLength=32) @sensitive
BETTER_AUTH_SECRET=

# Public origin where Better Auth is mounted.
# @type=url @public
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth web application credentials. Register
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
# @type=string(minLength=1) @public
GOOGLE_CLIENT_ID=

# Google OAuth client secret.
# @type=string(minLength=1) @sensitive
GOOGLE_CLIENT_SECRET=

# RevenueCat public SDK key for the active application environment.
# @type=string(minLength=1) @sensitive
REVENUECAT_API_KEY=

# RevenueCat webhook signature secret; required only by webhook deployments.
# @type=string(minLength=1) @sensitive @optional
REVENUECAT_WEBHOOK_SECRET=

# API base URL bundled into the Expo application.
# @type=url @public
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Next.js HTTP port.
# @type=port(min=1024) @public
PORT=3000

# Expo/Metro development port.
# @type=port(min=1024) @public
MOBILE_PORT=8081

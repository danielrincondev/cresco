{
  "name": "@cresco/movil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "varlock run -- expo start",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && npm run typecheck:convex",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "env:check": "varlock load",
    "convex:dev": "convex dev",
    "convex:sync-auth-env": "varlock printenv CLERK_JWT_ISSUER_DOMAIN | convex env set CLERK_JWT_ISSUER_DOMAIN"
  },
  "dependencies": {
    "@clerk/expo": "^4.3.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "convex": "^1.44.0",
    "expo": "~57.0.13",
    "expo-auth-session": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "jose": "^6.2.12",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "@varlock/bitwarden-plugin": "^2.0.0",
    "convex-test": "^0.0.55",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "varlock": "^1.18.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  }
}

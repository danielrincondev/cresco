{
  "expo": {
    "name": "Cresco",
    "slug": "cresco",
    "scheme": "cresco",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#EBF4FA",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "app.cresco.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EBF4FA"
      }
    },
    "plugins": [
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EBF4FA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27f464bd-add4-4602-8c14-c4454a4279f1"
      }
    },
    "owner": "kchung176",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/27f464bd-add4-4602-8c14-c4454a4279f1"
    },
    "ios": {}
  }
}

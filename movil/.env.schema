# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN, cacheTtl="5m")
# @generateTsTypes(path=./env.d.ts)
# @defaultRequired=true
# ---
# Machine-account token supplied by the host or CI environment.
# @type=bitwardenAccessToken @optional
BITWARDEN_ACCESS_TOKEN=

# Clerk publishable key bundled into the Expo application.
# @type=string(minLength=1) @public
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=bitwarden("00000000-0000-0000-0000-000000000000")

# Convex deployment URL bundled into the Expo application.
# @type=url @public
EXPO_PUBLIC_CONVEX_URL=bitwarden("00000000-0000-0000-0000-000000000000")

# Clerk Frontend API URL synchronized to the Convex deployment.
# @type=url @public @internal
CLERK_JWT_ISSUER_DOMAIN=https://rich-husky-2183.clerk.accounts.dev
